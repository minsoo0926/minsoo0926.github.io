<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Personal publication list</title>
    <id>https://minsoo0926.github.io/styles/publications</id>
    <updated>2026-10-28T00:00:00+00:00</updated>
  </info>
  <macro name="authors">
    <names variable="author">
      <name form="long" initialize="false" and="text" delimiter=", "/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>
  <citation>
    <layout delimiter="; ">
      <text macro="authors"/>
    </layout>
  </citation>
  <bibliography>
    <layout>
      <text variable="title" display="block" font-weight="bold"/>
      <text macro="authors" display="block"/>
      <group display="block" delimiter=". ">
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <text variable="volume"/>
          <text variable="issue" prefix="(" suffix=")"/>
          <text variable="page"/>
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </group>
        <text variable="note"/>
      </group>
    </layout>
  </bibliography>
</style>
